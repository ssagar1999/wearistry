# Copy this file to .env (or .env.local) and fill in what you need. Empty values are fine in dev mode.
# Never commit the real file; git ignores it.

# MongoDB Atlas connection string, e.g. mongodb+srv://<user>:<password>@<cluster>.mongodb.net/wearistry
# Leave empty to keep data in memory while developing.
MONGODB_URI=
# Long random string used to sign login cookies (e.g. `openssl rand -base64 32`). Required in production.
AUTH_SECRET=
# MSG91 OTP SMS (https://msg91.com). Without these, dev mode shows the code on screen instead of sending an SMS.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Photo storage on Amazon S3 (see docs/S3_SETUP.md). Without these, dev mode saves photos in .data/uploads.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
# Where photos are served from: your CloudFront domain (recommended) or the bucket URL, no trailing slash.
S3_PUBLIC_URL=
