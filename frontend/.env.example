# Copy to .env for local development. The web app has no database of its own: everything comes from the API.

# Where the backend API runs, as seen from this Next.js server. /api/v1/* is proxied there.
API_INTERNAL_URL=http://localhost:4000
# Show "Continue with Google" on the login page. Set to true once the backend has Google keys.
NEXT_PUBLIC_GOOGLE_LOGIN=false
