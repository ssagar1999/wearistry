# Copy to .env for local development: cp .env.example .env
# Every variable is explained in docs/ENVIRONMENT.md. Never commit .env.

NODE_ENV=development
PORT=4000

# Required. Local MongoDB or a MongoDB Atlas connection string with a database name, e.g.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/wearistry
MONGODB_URI=mongodb://127.0.0.1:27017/wearistry

# Browser origins allowed to call the API with cookies (comma-separated, no trailing slash).
CORS_ORIGINS=http://localhost:3000

LOG_LEVEL=info

# How many proxies sit in front of the API. 0 when called directly, 1 behind the Next.js proxy or a load balancer.
TRUST_PROXY_HOPS=0

# Requests allowed per IP per window, across all /api/v1 routes.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
