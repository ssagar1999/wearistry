# Copy to .env for local development: cp .env.example .env
# Every variable is explained in docs/ENVIRONMENT.md. Never commit .env.

NODE_ENV=development
PORT=4000

# Required. Local MongoDB or a MongoDB Atlas connection string with a database name, e.g.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/wearistry
MONGODB_URI=mongodb://127.0.0.1:27017/wearistry

# Browser origins allowed to call the API with cookies (comma-separated, no trailing slash).
CORS_ORIGINS=http://localhost:3000

LOG_LEVEL=info
# Readable logs (default: on in development). Docker images must use false.
# LOG_PRETTY=true

# How many proxies sit in front of the API. 1 in development (the Next.js proxy); match your real setup in production.
TRUST_PROXY_HOPS=1

# Requests allowed per IP per window, across all /api/v1 routes.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# --- Login (see docs/ENVIRONMENT.md, docs/GOOGLE_OAUTH_SETUP.md, docs/SMS_SETUP.md) ---

# Public URL of the web app (the browser only talks to it; it proxies /api/v1 here).
APP_URL=http://localhost:3000
# Required. At least 32 random characters: openssl rand -base64 32
AUTH_SECRET=
SESSION_TTL_DAYS=30
# Tighter per-IP limit for login endpoints, per 15 minutes.
AUTH_RATE_LIMIT_MAX=30

# Google sign-in. Leave both empty to turn it off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# MSG91 SMS for phone login codes. Leave both empty in development and use OTP_DEV_CODES.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# true = return login codes in the API response instead of sending SMS. Development only; refused in production.
OTP_DEV_CODES=true

# --- Photo storage (see docs/S3_SETUP.md). Required in production; leave empty in development. ---
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
# Your CloudFront domain (or bucket URL), no trailing slash.
S3_PUBLIC_URL=
# Local photo folder used when S3 isn't configured.
UPLOAD_DIR=.data/uploads
